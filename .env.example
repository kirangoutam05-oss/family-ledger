# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional. A Postgres connection string (e.g. from Supabase).
# When set, the ledger persists in Postgres and survives redeploys.
# When unset, the ledger falls back to a local JSON file (data/ledger.json),
# which is fine for local development but does not survive a redeploy on
# ephemeral hosting like Render's free tier.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY: Required for Web Push notifications
# (daily reminders, "your partner added an expense"). Generate a pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="MY_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="MY_VAPID_PRIVATE_KEY"

# VAPID_SUBJECT: A mailto: address identifying the sender, required by the
# Web Push protocol (push services use it to contact you if something's wrong).
VAPID_SUBJECT="mailto:you@example.com"

# CRON_SECRET: Required to call POST /api/cron/daily-reminder. Set this to a
# random string and configure your external scheduler (e.g. a GitHub Actions
# cron workflow, or cron-job.org) to send it as the X-Cron-Secret header.
CRON_SECRET="MY_CRON_SECRET"

# COOKIE_SECRET: Signs the login session cookie. Set this to a long random
# string (e.g. `openssl rand -hex 32`) and never change it without expecting
# everyone to be logged out.
COOKIE_SECRET="MY_COOKIE_SECRET"

# RESEND_API_KEY: Required to send password-reset emails via Resend
# (resend.com). Sign up, verify a sending domain (or use their shared
# onboarding@resend.dev sender for testing), and copy an API key.
RESEND_API_KEY="MY_RESEND_API_KEY"

# RESEND_FROM_EMAIL: Optional. The "From" address on password-reset emails.
# Defaults to Resend's shared test sender if unset (fine for development,
# but use a verified domain address in production for real deliverability).
RESEND_FROM_EMAIL="KNKU <noreply@yourdomain.com>"
